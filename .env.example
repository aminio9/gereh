GEREH_ENV=development

# Identity database
DATABASE_URL=postgres://gereh:gereh@postgres:5432/iam_db?sslmode=disable

# Tenant database
TENANT_DATABASE_URL=postgres://gereh:gereh@postgres:5432/tenant_db?sslmode=disable

TENANT_GRPC_ADDRESS=:18082
TENANT_GRPC_TARGET=passthrough:///127.0.0.1:18082
TENANT_GRPC_INSECURE=true

TENANT_EVENT_TOPIC=gereh.tenant.events.v1
TENANT_DEFAULT_REGION=local
TENANT_ALLOWED_REGIONS=local,eu-central-1,us-east-1
TENANT_DEFAULT_RETENTION_DAYS=90

TENANT_OUTBOX_BATCH_SIZE=100
TENANT_OUTBOX_POLL_INTERVAL=500ms
TENANT_OUTBOX_LEASE=30s
TENANT_OUTBOX_MAX_BACKOFF=5m

REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:19092
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_ACCESS_KEY_ID=gereh
S3_SECRET_ACCESS_KEY=gereh-local-secret
S3_FORCE_PATH_STYLE=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
OTEL_SERVICE_NAME=gereh-local

VITE_API_BASE_URL=http://localhost:8080
