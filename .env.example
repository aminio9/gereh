GEREH_ENVIRONMENT=development

# Identity database
DATABASE_URL=postgres://gereh:gereh-local-only@postgres:5432/iam_db?sslmode=disable

# Tenant service runtime connection.
# This role must not own tables and must not have BYPASSRLS.
TENANT_DATABASE_URL=postgres://gereh_tenant_app:gereh-tenant-app-local-only@postgres:5432/tenant_db?sslmode=disable

# Used only by migration tooling. Never inject this URL into the tenant-service
# runtime container.
TENANT_MIGRATION_DATABASE_URL=postgres://gereh_tenant_migrator:gereh-tenant-migrator-local-only@postgres:5432/tenant_db?sslmode=disable

TENANT_GRPC_ADDRESS=:18082
TENANT_GRPC_TARGET=passthrough:///127.0.0.1:18082
TENANT_GRPC_INSECURE=true

TENANT_EVENT_TOPIC=gereh.tenant.events.v1
TENANT_DEFAULT_REGION=local
TENANT_ALLOWED_REGIONS=local,eu-central-1,us-east-1
TENANT_DEFAULT_RETENTION_DAYS=90

# Tenant Service principal used internally by the workflow service to drive
# onboarding transitions (MarkRunning/Complete/Fail). Predetermined application
# identity (not a DB role).
TENANT_WORKFLOW_SERVICE_PRINCIPAL_ID=018f7767-28d2-7f5c-a693-0bb4c8ee4ae0

# Development-only internal auth for the Tenant Onboarding gRPC API. In
# production this is replaced by mTLS SPIFFE identity verification.
TENANT_INTERNAL_DEV_TOKEN=dev-token-change-me
# Comma-separated SPIFFE IDs allowed to call the internal onboarding API.
TENANT_INTERNAL_ALLOWED_SPIFFE_IDS=

TENANT_OUTBOX_BATCH_SIZE=100
TENANT_OUTBOX_POLL_INTERVAL=500ms
TENANT_OUTBOX_LEASE=30s
TENANT_OUTBOX_MAX_BACKOFF=5m

# Organization Service runtime connection.
# This role must not own tables and must not have BYPASSRLS.
ORGANIZATION_DATABASE_URL=postgres://gereh_organization_app:gereh-organization-app-local-only@postgres:5432/organization_db?sslmode=disable

# Used only by migration tooling. Never inject this URL into the
# organization-service runtime container.
ORGANIZATION_MIGRATION_DATABASE_URL=postgres://gereh_organization_migrator:gereh-organization-migrator-local-only@postgres:5432/organization_db?sslmode=disable

ORGANIZATION_GRPC_ADDRESS=:18083
ORGANIZATION_GRPC_TARGET=passthrough:///127.0.0.1:18083
ORGANIZATION_GRPC_INSECURE=true

ORGANIZATION_COMPANY_EVENT_TOPIC=gereh.organization.company.events.v1
ORGANIZATION_AGENT_EVENT_TOPIC=gereh.organization.agent.events.v1

ORGANIZATION_OUTBOX_BATCH_SIZE=100
ORGANIZATION_OUTBOX_POLL_INTERVAL=500ms
ORGANIZATION_OUTBOX_LEASE=30s
ORGANIZATION_OUTBOX_MAX_BACKOFF=5m

ORGANIZATION_AUTHORIZER_TIMEOUT=3s

# Organization Service principal used internally by the workflow service to
# drive default company provisioning. Predetermined application identity
# (not a DB role).
ORGANIZATION_BOOTSTRAP_SERVICE_PRINCIPAL_ID=018f7767-28d2-7f5c-a693-0bb4c8ee4ae3

# Development-only internal auth for the Organization Bootstrap gRPC API. In
# production this is replaced by mTLS SPIFFE identity verification.
ORGANIZATION_INTERNAL_DEV_TOKEN=dev-token-change-me
# Comma-separated SPIFFE IDs allowed to call the internal bootstrap API.
ORGANIZATION_INTERNAL_ALLOWED_SPIFFE_IDS=

# Work Management Service runtime connection.
# This role must not own tables and must not have BYPASSRLS.
WORK_DATABASE_URL=postgres://gereh_work_app:gereh-work-app-local-only@postgres:5432/work_db?sslmode=disable

# Used only by migration tooling. Never inject this URL into the
# work-management-service runtime container.
WORK_MIGRATION_DATABASE_URL=postgres://gereh_work_migrator:gereh-work-migrator-local-only@postgres:5432/work_db?sslmode=disable

WORK_GRPC_ADDRESS=:18084
WORK_GRPC_TARGET=passthrough:///127.0.0.1:18084
WORK_GRPC_INSECURE=true

WORK_EVENT_TOPIC=gereh.work.events.v1

WORK_POSTGRES_MAX_CONNECTIONS=20
WORK_POSTGRES_MIN_CONNECTIONS=2
WORK_SHUTDOWN_TIMEOUT=15s

WORK_OUTBOX_BATCH_SIZE=100
WORK_OUTBOX_POLL_INTERVAL=250ms
WORK_OUTBOX_LEASE=30s
WORK_OUTBOX_MAX_BACKOFF=30s

WORK_AUTHORIZER_TIMEOUT=3s
WORK_DOWNSTREAM_TIMEOUT=3s

# Policy Approval Service runtime connection.
# This role must not own tables and must not have BYPASSRLS.
POLICY_DATABASE_URL=postgres://gereh_policy_app:gereh-policy-app-local-only@postgres:5432/policy_db?sslmode=disable

# Used only by migration tooling. Never inject this URL into the
# policy-approval-service runtime container.
POLICY_MIGRATION_DATABASE_URL=postgres://gereh_policy_migrator:gereh-policy-migrator-local-only@postgres:5432/policy_db?sslmode=disable

POLICY_GRPC_ADDRESS=:18085
POLICY_DECISION_TTL=15m

# Development-only internal auth for the Policy Evaluation and Bootstrap gRPC
# APIs. In production this is replaced by mTLS SPIFFE identity verification.
POLICY_INTERNAL_DEV_TOKEN=dev-token-change-me
# Comma-separated SPIFFE IDs allowed to call the internal policy APIs.
POLICY_INTERNAL_ALLOWED_SPIFFE_IDS=

REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:19092
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_ACCESS_KEY_ID=gereh
S3_SECRET_ACCESS_KEY=gereh-local-secret
S3_FORCE_PATH_STYLE=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
OTEL_SERVICE_NAME=gereh-local

VITE_API_BASE_URL=http://localhost:8080
