COMPOSE_PROJECT_NAME=gereh-local

POSTGRES_IMAGE=postgres:18.4-bookworm
POSTGRES_USER=gereh
POSTGRES_PASSWORD=gereh-local-only
POSTGRES_PORT=5432

REDIS_IMAGE=redis:8.8.1-alpine
REDIS_PORT=6379

KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_PORT=9092

TEMPORAL_IMAGE=temporalio/temporal:1.8.1
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_METRICS_PORT=8000

VAULT_IMAGE=hashicorp/vault:2.0.4
VAULT_PORT=8200

# Model Access - BYOK
MODEL_ACCESS_VAULT_ADDRESS=http://127.0.0.1:8200
MODEL_ACCESS_VAULT_MOUNT=model-byok
MODEL_ACCESS_VAULT_NAMESPACE=
MODEL_ACCESS_VAULT_TOKEN_FILE=/var/run/gereh/vault/model-access.token
MODEL_ACCESS_VAULT_ALLOW_INSECURE_HTTP=true
MODEL_ACCESS_VAULT_TIMEOUT=5s
MODEL_ACCESS_FINGERPRINT_KEY_FILE=/var/run/gereh/vault/model-access-fingerprint.key
MODEL_ACCESS_FINGERPRINT_KEY_ID=v1
MODEL_ACCESS_PROVIDER_VERIFY_TIMEOUT=8s
MODEL_ACCESS_SECRET_CLEANUP_BATCH_SIZE=50
MODEL_ACCESS_SECRET_CLEANUP_POLL_INTERVAL=1s
MODEL_ACCESS_SECRET_CLEANUP_LEASE=30s
MODEL_ACCESS_SECRET_CLEANUP_MAX_BACKOFF=5m

# Model Gateway
MODEL_GATEWAY_DATABASE_URL=postgres://gereh_model_gateway_app:gereh-model-gateway-app-local-only@127.0.0.1:5432/model_gateway_db?sslmode=disable
MODEL_GATEWAY_MIGRATION_DATABASE_URL=postgres://gereh_model_gateway_migrator:gereh-model-gateway-migrator-local-only@127.0.0.1:5432/model_gateway_db?sslmode=disable
MODEL_GATEWAY_HTTP_ADDRESS=:8087
MODEL_GATEWAY_RESOLVER_GRPC_TARGET=passthrough:///127.0.0.1:18087
MODEL_GATEWAY_RESOLVER_GRPC_INSECURE=true
MODEL_GATEWAY_EVENT_TOPIC=gereh.model.usage.v1
MODEL_GATEWAY_REQUIRE_BUDGET_RESERVATION=false

