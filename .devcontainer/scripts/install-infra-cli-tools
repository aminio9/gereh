#!/usr/bin/env bash
set -Eeuo pipefail

KUBECTL_VERSION="${KUBECTL_VERSION:-v1.36.3}"
HELM_VERSION="${HELM_VERSION:-v4.2.3}"
TERRAFORM_VERSION="${TERRAFORM_VERSION:-1.15.8}"
GH_VERSION="${GH_VERSION:-2.96.0}"

case "$(uname -m)" in
  x86_64)
    kubectl_arch="amd64"
    helm_arch="amd64"
    terraform_arch="amd64"
    gh_arch="amd64"
    ;;
  aarch64|arm64)
    kubectl_arch="arm64"
    helm_arch="arm64"
    terraform_arch="arm64"
    gh_arch="arm64"
    ;;
  *)
    echo "Unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

download() {
  local url="$1"
  local output="$2"
  echo "Downloading: $url"
  curl \
    --fail \
    --location \
    --retry 5 \
    --retry-all-errors \
    --retry-delay 2 \
    --connect-timeout 20 \
    --max-time 1800 \
    --output "$output" \
    "$url"
}

install_kubectl() {
  local binary="$workdir/kubectl"
  local checksum="$workdir/kubectl.sha256"
  local base="https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${kubectl_arch}"

  download "$base/kubectl" "$binary"
  download "$base/kubectl.sha256" "$checksum"
  echo "$(cat "$checksum")  $binary" | sha256sum --check -
  sudo install -m 0755 "$binary" /usr/local/bin/kubectl
}

install_helm() {
  local archive_name="helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz"
  local archive="$workdir/$archive_name"
  local checksum="$workdir/${archive_name}.sha256sum"
  local base="https://get.helm.sh"

  download "$base/$archive_name" "$archive"
  download "$base/${archive_name}.sha256sum" "$checksum"
  echo "$(cat "$checksum")  $archive" | sha256sum --check -
  tar -xzf "$archive" -C "$workdir"
  sudo install -m 0755 "$workdir/linux-${helm_arch}/helm" /usr/local/bin/helm
}

install_terraform() {
  local archive_name="terraform_${TERRAFORM_VERSION}_linux_${terraform_arch}.zip"
  local archive="$workdir/$archive_name"
  local checksums="$workdir/terraform_${TERRAFORM_VERSION}_SHA256SUMS"
  local base="https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}"

  download "$base/$archive_name" "$archive"
  download "$base/terraform_${TERRAFORM_VERSION}_SHA256SUMS" "$checksums"
  (
    cd "$workdir"
    grep " $archive_name$" "$checksums" | sha256sum --check -
  )
  mkdir -p "$workdir/terraform"
  unzip -q "$archive" -d "$workdir/terraform"
  sudo install -m 0755 "$workdir/terraform/terraform" /usr/local/bin/terraform
}

install_gh() {
  local version="${GH_VERSION#v}"
  local archive_name="gh_${version}_linux_${gh_arch}.tar.gz"
  local archive="$workdir/$archive_name"
  local checksums="$workdir/gh_${version}_checksums.txt"
  local base="https://github.com/cli/cli/releases/download/v${version}"

  github-download "$base/$archive_name" "$archive"
  github-download "$base/gh_${version}_checksums.txt" "$checksums"
  (
    cd "$workdir"
    grep "  $archive_name$" "$checksums" | sha256sum --check -
  )
  tar -xzf "$archive" -C "$workdir"
  sudo install -m 0755 "$workdir/gh_${version}_linux_${gh_arch}/bin/gh" /usr/local/bin/gh
}

install_kubectl
install_helm
install_terraform
install_gh

echo "Infrastructure CLI tools installed successfully."
